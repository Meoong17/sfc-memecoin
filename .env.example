# SFC Memecoin — environment template
# Copy to .env and fill real keys. NEVER commit .env.
#
# On-chain RPC (Helius: https://dashboard.helius.dev/ -> API keys)
HELIUS_API_KEY=
SOLANA_RPC_URL=
BSC_RPC_URL=
QUICKNODE_URL=
#
# DEX / market data
DEXSCREENER_API_KEY=      # optional; public DexScreener works without key
BIRDEYE_API_KEY=          # optional
#
# GMGN OpenAPI — accessed via gmgn-cli (npm). Apply key at https://gmgn.ai/ai
# GMGN_PRIVATE_KEY is a request-signing key (NOT a wallet key). Keep private.
GMGN_API_KEY=
GMGN_PRIVATE_KEY=
#
# Social
TWITTER_BEARER=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
